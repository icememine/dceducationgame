# Leave empty in local dev: the app uses an embedded PGlite database in ./.data
# Production: a managed Postgres (VN-hosted if data-residency rules require it)
DATABASE_URL=

# Auth adapter: "dev" (cookie demo user) | "oidc" (DragonX SSO, to be implemented)
AUTH_MODE=dev
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Deep links shown as CTAs at the end of units
NEXT_PUBLIC_DRAGONX_URL=https://dragonx.com.vn

# Hỏi Rồng (AI). Empty → answers come from the Q&A library without calling a model.
ANTHROPIC_API_KEY=
# Model for AI features; default claude-opus-5-5
AI_MODEL=
# 1 = re-read content/ai/rong-voice.md on every request (handy while tuning the voice)
AI_VOICE_RELOAD=
# Hỏi Rồng questions per learner per day (default 30)
RONG_DAILY_LIMIT=

# Opens every lesson for content review (staging only, never production)
CONTENT_PREVIEW=

# Scheduled jobs: /api/cron/reminders (hourly) and /api/cron/leagues (after Sunday midnight VN).
# Callers send "Authorization: Bearer <CRON_SECRET>". Empty → the cron endpoints refuse requests.
CRON_SECRET=
# Web Push for study reminders. Empty → reminders stay in-app only. Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# Internal /admin (analytics, content editor, market-drop simulator). Sign in at /admin/login.
# Production with either empty → /admin returns 404. Local dev without them: test login in docs/ADMIN_TEST.md.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional: let the content editor open pull requests (token with contents + pull-requests write)
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BASE=main
# Only for tests or GitHub Enterprise; default https://api.github.com
GITHUB_API_URL=
