# Leave empty in local dev: the app uses an embedded PGlite database in ./.data
# Production: a managed Postgres (VN-hosted if data-residency rules require it)
DATABASE_URL=

# Auth adapter: "dev" (cookie demo user) | "oidc" (DragonX SSO, to be implemented)
AUTH_MODE=dev
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Deep links shown as CTAs at the end of units
NEXT_PUBLIC_DRAGONX_URL=https://dragonx.com.vn

# Hỏi Rồng (AI). Empty → answers come from the Q&A library without calling a model.
ANTHROPIC_API_KEY=
# Model for AI features; default claude-opus-5-5
AI_MODEL=
# 1 = re-read content/ai/rong-voice.md on every request (handy while tuning the voice)
AI_VOICE_RELOAD=
